# Sao chép thành .env.local rồi điền cấu hình project Supabase của bạn.
# Không commit .env.local hoặc giá trị secret lên Git.
# Để trống (hoặc bỏ biến này) để chạy bản một gia đình.
FAMILY_ID=""
SITE_NAME="Gia Phả"

# Local dùng http://localhost:3000; production dùng origin HTTPS, không đường dẫn.
APP_URL="http://localhost:3000"

# Thay ref mẫu gồm 20 chữ thường/chữ số bằng ref project của bạn.
NEXT_PUBLIC_SUPABASE_URL="https://abcdefghijklmnopqrst.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="replace-with-your-publishable-or-anon-key"
# Giữ true nếu chưa cấu hình provider Google/Facebook trong Supabase Auth.
NEXT_PUBLIC_DISABLE_SSO="true"

# SERVER-ONLY: cần cho ảnh và chức năng dùng admin client.
# Secret key hoặc legacy service_role của cùng project. Không dùng NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=""

# SERVER-ONLY: PostgreSQL connection string của cùng project, dùng TLS.
# Cần cho migration trong Dashboard và backup toàn website, không bắt buộc để chạy setup SQL thủ công.
# Lấy từ mục Connect của Supabase; mã hóa URL cho ký tự đặc biệt trong mật khẩu.
# Dạng: postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_URL=""

# Tùy chọn: email thông báo ứng dụng (không thay cấu hình email Supabase Auth).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Bỏ trống để lấy email admin hoạt động; nhiều địa chỉ ngăn cách bằng dấu phẩy.
ADMIN_NOTIFICATION_EMAIL=""

# Tùy chọn: HTTPS URL manifest phát hành đã được kiểm tra, để trống nếu chưa có.
PRODUCT_RELEASE_MANIFEST_URL=""

# Backup toàn website: local/máy chủ riêng, không hỗ trợ trên Vercel.
# Cần SQL + service-role ở trên; .ftbackup mã hóa bằng mật khẩu, tối đa 128 MiB.
WEBSITE_BACKUP_ENABLED="false"
# UUID admin hoạt động được chỉ định vận hành backup.
WEBSITE_BACKUP_OPERATOR_ID=""

# Tùy chọn SERVER-ONLY: nguồn ngoài khi chuyển dữ liệu; bình thường để trống.
WEBSITE_BACKUP_SOURCE_PROJECT_REF=""
WEBSITE_BACKUP_SOURCE_DB_URL=""
WEBSITE_BACKUP_SOURCE_SERVICE_ROLE_KEY=""
